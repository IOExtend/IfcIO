{
  "metadata": [
    {
      "src": [
        { "src": "src/IfcIO", "files": ["IfcIO.csproj"] },
        { "src": "src/IfcIO.Scene", "files": ["IfcIO.Scene.csproj"] }
      ],
      "dest": "docs/api",
      "properties": { "TargetFramework": "net10.0" },
      "outputFormat": "apiPage"
    }
  ],
  "build": {
    "content": [
      { "src": "docs", "files": ["*.md", "toc.yml", "api/**/*.yml", "api/**/*.md"] }
    ],
    "resource": [
      { "src": "docs", "files": ["images/**"] }
    ],
    "output": "_site",
    "globalMetadata": {
      "_appTitle": "IfcIO",
      "_appFooter": "IfcIO is licensed under the MIT License. Not affiliated with buildingSMART.",
      "_enableSearch": true
    },
    "template": ["default", "modern"]
  }
}
